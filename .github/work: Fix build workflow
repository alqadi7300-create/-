name: Build APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.24.5'
          channel: stable

      - name: Create Android project
        run: flutter create --project-name mohamed_alqadi_education --platforms=android .

      - name: Fix Android compileSdk
        run: |
          if [ -f android/app/build.gradle.kts ]; then
            sed -i -E 's/compileSdk(Version)?[[:space:]]*=[[:space:]]*flutter\.compileSdkVersion/compileSdk = 35/g' android/app/build.gradle.kts
            sed -i -E 's/compileSdk(Version)?[[:space:]]+flutter\.compileSdkVersion/compileSdk = 35/g' android/app/build.gradle.kts
          fi

          if [ -f android/app/build.gradle ]; then
            sed -i -E 's/compileSdkVersion[[:space:]]+flutter\.compileSdkVersion/compileSdkVersion 35/g' android/app/build.gradle
            sed -i -E 's/compileSdk[[:space:]]+flutter\.compileSdkVersion/compileSdk 35/g' android/app/build.gradle
          fi

          echo "Checking compileSdk:"
          grep -R "compileSdk" android/app || true

      - name: Verify main.dart
        run: |
          echo "Checking main.dart..."

          if grep -n "convertHtmlToPdf" lib/main.dart; then
            echo "ERROR: convertHtmlToPdf still exists in main.dart"
            exit 1
          fi

          echo "main.dart is OK"

      - name: Get dependencies
        run: flutter pub get

      - name: Build APK
        run: flutter build apk --release

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: mohamed-alqadi-education-apk
          path: build/app/outputs/flutter-apk/app-release.apk
